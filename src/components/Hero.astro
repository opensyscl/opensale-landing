---
/**
 * Hero de dos columnas (replica del template Solva de Framer):
 *  - Izquierda: badge, titulo serif grande, parrafo y CTA.
 *  - Derecha: imagen de fondo (flores) + captura real del panel, con ring blanco.
 *  - Abajo: marquee de socios e integraciones reales.
 *  - Fondo: halftone animado en canvas 2D, a todo lo ancho de la seccion.
 */

import { marcas } from '../data/marcas';
import { socios } from '../data/confianza';
---

<section class="relative overflow-hidden bg-canvas">
  {/* Halftone animado de fondo: textura a todo lo ancho, detras del contenido */}
  <canvas id="hero-halftone" class="hero-halftone" aria-hidden="true"></canvas>

  <div class="relative mx-auto w-full max-w-[1200px] px-5 pt-10 pb-16 md:px-10 md:pt-16">
    <div class="flex flex-col items-center gap-12 lg:flex-row lg:items-stretch lg:gap-0">
      {/* Columna izquierda: texto */}
      <div class="flex w-full flex-col items-start gap-8 lg:w-[45%] lg:pb-8 lg:pr-10">
        <div class="flex flex-col items-start gap-6">
          {/* Badge */}
          <a
            href="#automatizaciones"
            class="group inline-flex items-center gap-2 rounded-md transition-opacity hover:opacity-80"
          >
            <span class="rounded-[4px] bg-[#f4f2ec] px-1.5 py-1 text-[12px] leading-none font-medium tracking-wide text-muted">
              NUEVO
            </span>
            <span class="text-[16px] leading-none text-muted">Automatizaciones que venden solas</span>
            <svg viewBox="0 0 24 24" class="h-4 w-4 text-muted" fill="none" aria-hidden="true">
              <path
                d="M5 12h14M13 6l6 6-6 6"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>
            </svg>
          </a>

          {/* Titulo */}
          <h1 class="max-w-[600px] font-serif text-[46px] leading-[1.05] font-light tracking-[-0.05em] text-[#0f0f0f] sm:text-[52px] lg:text-[56px]">
            Toda tu operación de ventas, en un solo lugar.
          </h1>

          {/* Parrafo */}
          <p class="max-w-[400px] text-[18px] leading-[1.4] text-muted">
            OpenSale centraliza pedidos, inventario y facturación, y automatiza lo repetitivo para
            que tu equipo venda en vez de cargar planillas.
          </p>
        </div>

        {/* CTA */}
        <a
          href="#empezar"
          class="boton-relieve inline-flex h-11 items-center justify-center rounded-lg bg-accent-deep px-4 text-[14px] font-medium text-canvas transition-colors duration-200 hover:bg-accent-deep/90"
        >
          Probar OpenSale gratis
        </a>
      </div>

      {/* Columna derecha: imagen + mockup */}
      <div class="relative h-[360px] w-full overflow-hidden rounded-2xl border-r border-b border-border sm:h-[460px] lg:h-[560px] lg:w-[55%]">
        {/* Fondo de flores */}
        <img
          src="/images/hero/hero-flowers.webp"
          width="896"
          height="896"
          decoding="async"
          alt=""
          aria-hidden="true"
          class="absolute inset-0 h-full w-full object-cover"
        />
        {/*
          Captura real del Panel de Control del ERP, flotando y desbordando a la
          derecha. Reemplaza al mockup dibujado a mano que habia antes: en el
          hero conviene mostrar el producto de verdad.

          Es el LCP de la home: va con fetchpriority alto y precargado desde Base.
        */}
        <img
          src="/images/producto/panel.webp"
          width="1600"
          height="792"
          decoding="async"
          fetchpriority="high"
          alt="Panel de control de OpenSale con ingresos, margen, ventas por hora y estado de caja"
          class="absolute top-16 left-16 w-[975px] max-w-none rounded-[10px] shadow-[0_1px_3px_rgba(0,0,0,0.03),0_4px_16px_rgba(0,0,0,0.04),0_0_0_8px_rgba(255,255,255,0.5)]"
        />
      </div>
    </div>

    {/* Marquee de socios e integraciones */}
    <div class="mt-16 lg:mt-24">
      <p class="text-center text-[13px] leading-[1.4] text-muted">
        Acreditados y conectados con
      </p>

      <div class="marquee relative mt-6 overflow-hidden">
        {/*
          Una sola pista con la lista duplicada: la animacion la corre -50%, o
          sea exactamente un juego completo, y el bucle no tiene corte. La
          segunda copia va aria-hidden para que un lector de pantalla no lea
          dos veces los mismos ocho nombres.
        */}
        <ul class="marquee-track flex w-max items-center gap-[56px]">
          {[...socios.map((s) => ({ ...s, copia: false })), ...socios.map((s) => ({ ...s, copia: true }))].map((s) => (
            <li
              class="flex shrink-0 items-center gap-2.5 text-[17px] leading-none font-medium tracking-[-0.03em] text-ink/85"
              aria-hidden={s.copia ? 'true' : undefined}
            >
              <svg viewBox="0 0 24 24" class="h-[22px] w-[22px] shrink-0" fill="currentColor" aria-hidden="true">
                <path d={marcas[s.marca]} />
              </svg>
              {s.nombre}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  /*
   * El halftone vive en los margenes: la mascara radial abre un hueco sobre la
   * columna de texto (centro en 26% 44%, que es donde cae el bloque titulo +
   * parrafo + CTA) y recien afuera deja aparecer los puntos. El degradado es
   * largo a proposito, asi el borde del hueco no se ve como un corte.
   *
   * Una sola capa de mascara: con dos + mask-composite, Lightning CSS descarta
   * la regla entera y el canvas queda sin posicionar.
   */
  .hero-halftone {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0.34;
    -webkit-mask-image: radial-gradient(ellipse 46% 52% at 26% 44%, transparent 48%, #000 92%);
    mask-image: radial-gradient(ellipse 46% 52% at 26% 44%, transparent 48%, #000 92%);
  }

  /* Marquee: desplazamiento continuo con fundido en los bordes */
  .marquee {
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      #000 12%,
      #000 88%,
      transparent
    );
    mask-image: linear-gradient(to right, transparent, #000 12%, #000 88%, transparent);
  }

  .marquee-track {
    animation: marquee 32s linear infinite;
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>

<script>
  import { halftone } from '../scripts/halftone';

  const canvas = document.getElementById('hero-halftone');
  if (canvas instanceof HTMLCanvasElement) {
    // El color sale del token, asi el halftone sigue a la marca sin hex sueltos.
    const accent = getComputedStyle(document.documentElement)
      .getPropertyValue('--color-accent')
      .trim();

    halftone(canvas, {
      color: accent || undefined,
      spacing: 20,
      dot: 3.1,
      scale: 0.85,
      speed: 0.9,
      // Umbrales anchos: la banda de la onda cubre casi todo el cuadro en vez
      // de dejar medio hero vacio cuando la cresta se corre para afuera.
      umbralBajo: -0.55,
      umbralAlto: 0.85,
    });
  }
</script>
