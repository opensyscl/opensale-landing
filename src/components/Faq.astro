---
/**
 * Preguntas frecuentes.
 *
 * <details> nativo en vez de JS: abre y cierra sin hidratar nada, el navegador
 * lo hace accesible solo, y el texto de las respuestas queda en el HTML aunque
 * esten cerradas — que es lo que necesita un buscador para indexarlas.
 *
 * El JSON-LD de FAQPage lo emite la pagina, no este componente, para que entre
 * en el mismo @graph que el resto del schema. Ver index.astro.
 */
import { faq } from '../data/faq';
---

<section id="preguntas" class="bg-canvas">
  <div class="mx-auto w-full max-w-[1200px] px-5 py-16 md:px-10 lg:py-20">
    <div class="flex items-center gap-1.5 pl-0.5">
      <span class="h-[5px] w-2.5 rounded-full bg-muted"></span>
      <span class="text-[13px] leading-[1.3] text-muted">Preguntas</span>
    </div>

    <h2 class="mt-4 max-w-[680px] font-serif text-[26px] leading-[1.05] font-light tracking-[-0.05em] text-ink sm:text-[30px] lg:text-[36px]">
      Lo que preguntan<br /><span class="text-muted/60">antes de decidirse.</span>
    </h2>

    <div class="mt-10 grid grid-cols-1 gap-x-10 lg:grid-cols-2">
      {faq.map((f) => (
        <details class="faq group border-b border-border">
          <summary
            class="flex cursor-pointer list-none items-start justify-between gap-4 py-5 text-[15px] leading-[1.4] font-medium tracking-[-0.01em] text-ink transition-colors duration-200 hover:text-accent-deep"
          >
            {f.p}
            <span
              class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center text-muted transition-transform duration-200 group-open:rotate-45"
              aria-hidden="true"
            >
              <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="currentColor">
                <path d="M11 5h2v6h6v2h-6v6h-2v-6H5v-2h6V5Z" />
              </svg>
            </span>
          </summary>
          <p class="pb-5 text-[14px] leading-[1.55] text-muted">{f.r}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  /* Safari todavia pide esto para sacarle el triangulito al summary. */
  .faq summary::-webkit-details-marker {
    display: none;
  }
</style>
