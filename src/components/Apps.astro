---
/**
 * Las superficies del producto.
 *
 * Existe porque la landing contaba OpenSale como si fuera una sola pantalla, y
 * son varias sobre los mismos datos. Es el argumento que lo separa de un ERP
 * de escritorio, y hasta ahora no estaba escrito en ninguna parte del sitio.
 *
 * Dos filas distintas a proposito: arriba las que tienen captura real, con la
 * imagen; abajo las de Android y WhatsApp, que existen pero todavia no tienen
 * pantalla fotografiada. Mezclarlas obligaria a dibujarle un mockup a las que
 * faltan, que es exactamente lo que no se hace aca.
 */
import { apps, iconosApp } from '../data/apps';

const conCaptura = apps.filter((a) => a.captura);
const sinCaptura = apps.filter((a) => !a.captura);
---

<section id="apps" class="bg-canvas">
  <div class="mx-auto w-full max-w-[1200px] px-5 py-16 md:px-10 lg:py-20">
    <div class="flex items-center gap-1.5 pl-0.5">
      <span class="h-[5px] w-2.5 rounded-full bg-muted"></span>
      <span class="text-[13px] leading-[1.3] text-muted">Un producto, varias pantallas</span>
    </div>

    <h2 class="mt-4 max-w-[680px] font-serif text-[26px] leading-[1.05] font-light tracking-[-0.05em] text-ink sm:text-[30px] lg:text-[36px]">
      No es un sistema.<br /><span class="text-muted/60">Es donde trabaja cada uno de tu equipo.</span>
    </h2>

    <p class="mt-4 max-w-[560px] text-[15px] leading-[1.5] text-muted">
      La misma venta se ve en el mostrador, en la oficina y en el teléfono del repartidor.
      Nadie vuelve a cargar lo que ya cargó otro.
    </p>

    <ul class="mt-10 grid grid-cols-1 gap-4 md:grid-cols-2">
      {conCaptura.map((a) => (
        <li class="flex flex-col overflow-hidden rounded-3xl border border-border bg-surface">
          <div class="flex items-start gap-3 p-6">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-accent/10 text-accent-deep">
              <svg viewBox="0 0 24 24" class="h-[18px] w-[18px]" fill="currentColor" aria-hidden="true">
                <path d={iconosApp[a.icono]} />
              </svg>
            </span>
            <div class="flex flex-col gap-1">
              <span class="text-[11px] leading-none font-medium tracking-wide text-muted uppercase">{a.donde}</span>
              <h3 class="text-[17px] leading-[1.25] font-medium tracking-[-0.02em] text-ink">{a.nombre}</h3>
              <p class="mt-1 text-[14px] leading-[1.45] text-muted">{a.que}</p>
            </div>
          </div>

          {/*
            La captura asoma desde abajo y se corta: se ve que es el producto
            de verdad sin pedirle al visitante que lea una pantalla a 300 px.
          */}
          <div class="grano relative mx-6 h-[190px] overflow-hidden rounded-t-xl border-x border-t border-border bg-surface">
            <img
              src={a.captura}
              width="1440"
              height="900"
              loading="lazy"
              decoding="async"
              alt={`${a.nombre} de OpenSale: ${a.que}`}
              class="absolute top-0 left-0 w-[160%] max-w-none"
            />
          </div>
        </li>
      ))}
    </ul>

    {/* Las que existen pero no tienen captura todavia */}
    <ul class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-3">
      {sinCaptura.map((a) => (
        <li class="flex items-start gap-3 rounded-3xl border border-dashed border-border bg-surface/60 p-6">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-ink/[0.04] text-ink/70">
            <svg viewBox="0 0 24 24" class="h-[18px] w-[18px]" fill="currentColor" aria-hidden="true">
              <path d={iconosApp[a.icono]} />
            </svg>
          </span>
          <div class="flex flex-col gap-1">
            <span class="flex items-center gap-2">
              <span class="text-[11px] leading-none font-medium tracking-wide text-muted uppercase">{a.donde}</span>
              {a.version && (
                <span class="rounded bg-ink/[0.05] px-1.5 py-0.5 text-[10px] leading-none font-medium text-muted">
                  v{a.version}
                </span>
              )}
            </span>
            <h3 class="text-[15px] leading-[1.25] font-medium tracking-[-0.02em] text-ink">{a.nombre}</h3>
            <p class="mt-0.5 text-[13px] leading-[1.45] text-muted">{a.que}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
