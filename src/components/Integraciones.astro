---
/**
 * Seccion de integraciones. Todo lo que aparece aca esta configurado de verdad
 * en el ERP (config/services.php y app/Services/), no es una lista de deseos.
 */
type Item = { nombre: string; que: string };
type Grupo = { titulo: string; items: Item[] };

const grupos: Grupo[] = [
  {
    titulo: 'Cobros',
    items: [
      { nombre: 'Transbank Webpay', que: 'Pago con tarjeta en el punto de venta y en línea.' },
      { nombre: 'Webpay OneClick', que: 'Cobro recurrente de la suscripción, sin volver a pedir la tarjeta.' },
      { nombre: 'Mercado Pago', que: 'Link de pago y webhook de confirmación automática.' },
    ],
  },
  {
    titulo: 'Facturación',
    items: [
      { nombre: 'SII', que: 'Boleta y factura electrónica emitidas y enviadas al servicio.' },
      { nombre: 'mindicador.cl', que: 'Valor UF del día, para los planes y precios indexados.' },
    ],
  },
  {
    titulo: 'Mensajería',
    items: [
      { nombre: 'WhatsApp', que: 'Avisos y comprobantes al cliente desde tu propio número.' },
      { nombre: 'Correo', que: 'Comprobantes y recordatorios por mail, con Resend o SES.' },
      { nombre: 'Slack', que: 'Alertas internas del equipo en el canal que elijas.' },
    ],
  },
  {
    titulo: 'Reparto',
    items: [
      { nombre: 'Mapbox', que: 'Mapa y trazado de las rutas de reparto.' },
      { nombre: 'Google Maps', que: 'Geocodificación de las direcciones de tus clientes.' },
      { nombre: 'Notificaciones push', que: 'Avisos al repartidor en la app, vía Firebase.' },
    ],
  },
  {
    titulo: 'Infraestructura',
    items: [
      { nombre: 'Cloudflare R2', que: 'Fotos de productos y documentos, servidos rápido.' },
      { nombre: 'Turnstile', que: 'Protección de los formularios públicos, sin captchas molestos.' },
    ],
  },
];
---

<section id="integraciones" class="bg-canvas">
  <div class="mx-auto w-full max-w-[1200px] px-5 py-16 md:px-10 lg:py-20">
    <div class="flex items-center gap-1.5 pl-0.5">
      <span class="h-[5px] w-2.5 rounded-full bg-muted"></span>
      <span class="text-[13px] leading-[1.3] text-muted">Integraciones</span>
    </div>
    <h2 class="mt-4 max-w-[680px] font-serif text-[26px] leading-[1.05] font-light tracking-[-0.05em] text-ink sm:text-[30px] lg:text-[36px]">
      Ya habla con lo que usás.<br /><span class="text-muted/60">Sin plugins ni intermediarios.</span>
    </h2>

    <div class="mt-10 grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
      {grupos.map((g) => (
        <div class="flex flex-col rounded-3xl border border-border bg-surface p-6">
          <h3 class="text-[11px] leading-none font-medium tracking-wide text-muted uppercase">{g.titulo}</h3>
          <ul class="mt-4 flex flex-col divide-y divide-border border-t border-border">
            {g.items.map((i) => (
              <li class="py-3.5">
                <div class="text-[13px] leading-[1.3] font-medium text-ink">{i.nombre}</div>
                <p class="mt-1 text-[12px] leading-[1.5] text-muted">{i.que}</p>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <p class="mt-6 text-[12px] leading-[1.5] text-muted">
      ¿Te falta una? El plan Enterprise incluye acceso a la API para conectar lo que necesites.
    </p>
  </div>
</section>
