---
/**
 * Sección de features "Tres formas en que OpenSale ordena tus ventas"
 * (replica de la sección de 3 columnas del template Solva).
 * Cada tarjeta: bloque visual + mini-mockup HTML encima + título + bajada.
 *
 * Ventas e Inventario llevan captura real del ERP de fondo; Facturación sigue
 * con la acuarela porque esa pantalla no existe fotografiada en el repo.
 *
 * `velo` es explicito y no se deduce del formato del archivo: solo las capturas
 * lo necesitan, porque el mini-panel es blanco y se pierde encima de ellas. La
 * acuarela ya es suficientemente clara.
 */
const cards = [
  {
    bg: '/images/features/venta.webp',
    velo: true,
    title: 'Cerrá ventas en segundos',
    body: 'Cargá pedidos y cobrá al instante, sin planillas ni idas y vueltas.',
    mock: 'venta' as const,
  },
  {
    bg: '/images/features/inventario.webp',
    velo: true,
    title: 'Tu inventario siempre al día',
    body: 'El stock se actualiza solo con cada venta y compra, en tiempo real.',
    mock: 'inventario' as const,
  },
  {
    bg: '/images/features/card-3.webp',
    velo: false,
    title: 'Factura sin fricción',
    body: 'Emití comprobantes automáticamente y mandálos al cliente al confirmar.',
    mock: 'factura' as const,
  },
];

const stock = [
  { nombre: 'Cemento Portland 25kg', estado: 'En stock', tono: 'ok' },
  { nombre: 'Malla electrosoldada', estado: 'En stock', tono: 'ok' },
  { nombre: 'Alambre recocido 2mm', estado: 'Sincronizando', tono: 'sync' },
];
---

<section id="que-hace" class="mx-auto flex w-full max-w-[1200px] flex-col items-center gap-12 px-5 py-[72px] md:px-10 lg:gap-16 lg:py-24">
  {/* Encabezado */}
  <div class="w-full max-w-[600px] self-start">
    <div class="flex items-center gap-1.5 pl-0.5">
      <span class="h-[5px] w-2.5 rounded-full bg-[#71717a]"></span>
      <span class="text-[15px] leading-[1.3] text-[#71717a]">Qué hace OpenSale</span>
    </div>
    <h2 class="mt-4 font-serif text-[38px] leading-[1.05] font-light tracking-[-0.05em] text-[#111] sm:text-[40px] lg:text-[48px]">
      Tres formas en que OpenSale<br /><span class="text-[#b0b0b0]">ordena tus ventas.</span>
    </h2>
  </div>

  {/* Grilla de tarjetas */}
  <div class="flex w-full flex-col items-center gap-8 md:grid md:grid-cols-2 md:gap-6 lg:flex lg:flex-row lg:items-start">
    {cards.map((c) => (
      <div class="flex w-full max-w-[360px] flex-1 flex-col items-start gap-4">
        {/* Bloque visual */}
        <div class="relative flex h-[336px] w-full items-center justify-center overflow-hidden rounded-xl p-6">
          <img
            src={c.bg}
            width={c.bg.includes("card-") ? 1024 : 1440}
            height={c.bg.includes("card-") ? 683 : 900}
            loading="lazy"
            decoding="async"
            alt=""
            aria-hidden="true"
            class="absolute inset-0 h-full w-full object-cover"
          />
          {/* Velo: el mini-panel es blanco y sin esto se pierde contra la captura. */}
          {c.velo && (
            <span class="absolute inset-0 bg-ink/25" aria-hidden="true"></span>
          )}

          {/* Mini-mockup */}
          <div class="relative z-10 w-full max-w-[288px]">
            {c.mock === 'venta' && (
              <div class="rounded-2xl bg-surface p-4 shadow-[0_10px_30px_-12px_rgba(17,17,17,0.35)]">
                <div class="flex items-center gap-2.5">
                  <span class="flex h-8 w-8 items-center justify-center rounded-full bg-ink/[0.06] text-[11px] font-medium text-muted">CA</span>
                  <span class="flex-1 text-[13px] font-medium text-ink">Comercial Andes</span>
                  <span class="text-[11px] text-muted">14:07</span>
                </div>
                <div class="mt-3 rounded-xl bg-ink/[0.04] p-3">
                  <div class="text-[13px] font-medium text-ink">Pedido #4821 confirmado</div>
                  <div class="mt-0.5 text-[12px] text-muted">3 productos · $184.200</div>
                  <span class="mt-2 inline-flex items-center gap-1 rounded-full bg-success/10 px-2 py-0.5 text-[11px] font-medium text-success">
                    <span class="h-1.5 w-1.5 rounded-full bg-success"></span> Pagado
                  </span>
                </div>
                <div class="mt-3 flex items-center justify-center gap-1.5 text-[12px] text-muted">
                  <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="currentColor" aria-hidden="true"><path d="M12 2l1.6 5.4L19 9l-5.4 1.6L12 16l-1.6-5.4L5 9l5.4-1.6z" /></svg>
                  Cobrado en 4s
                </div>
              </div>
            )}

            {c.mock === 'inventario' && (
              <div class="overflow-hidden rounded-2xl bg-surface p-2 shadow-[0_10px_30px_-12px_rgba(17,17,17,0.35)]">
                {stock.map((s, i) => (
                  <div class={`flex items-center gap-3 px-3 py-3 ${i > 0 ? 'border-t border-border/70' : ''}`}>
                    <span class="h-7 w-7 shrink-0 rounded-lg bg-ink/[0.05]"></span>
                    <span class="flex-1 truncate text-[13px] text-ink">{s.nombre}</span>
                    <span
                      class={`inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[11px] font-medium ${s.tono === 'ok' ? 'bg-success/10 text-success' : 'bg-warning/10 text-warning'}`}
                    >
                      {s.tono === 'ok' ? (
                        <svg viewBox="0 0 24 24" class="h-3 w-3" fill="none" aria-hidden="true"><path d="M5 12l4 4L19 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
                      ) : (
                        <span class="h-1.5 w-1.5 rounded-full bg-warning"></span>
                      )}
                      {s.estado}
                    </span>
                  </div>
                ))}
              </div>
            )}

            {c.mock === 'factura' && (
              <div class="rounded-2xl bg-surface p-4 shadow-[0_10px_30px_-12px_rgba(17,17,17,0.35)]">
                <div class="flex items-center justify-between">
                  <span class="text-[13px] font-semibold text-ink">Factura B-0001</span>
                  <span class="inline-flex items-center gap-1 rounded-full bg-success/10 px-2 py-0.5 text-[11px] font-medium text-success">
                    <span class="h-1.5 w-1.5 rounded-full bg-success"></span> Emitida
                  </span>
                </div>
                <div class="mt-3 flex flex-col gap-1.5 text-[12px] text-muted">
                  <div class="flex items-center justify-between"><span>Subtotal</span><span>$152.231</span></div>
                  <div class="flex items-center justify-between"><span>IVA 21%</span><span>$31.969</span></div>
                </div>
                <div class="mt-2 flex items-center justify-between border-t border-border/70 pt-2">
                  <span class="text-[13px] font-medium text-ink">Total</span>
                  <span class="text-[15px] font-semibold text-ink">$184.200</span>
                </div>
                <div class="mt-3 flex items-center gap-1.5 text-[12px] text-muted">
                  <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" aria-hidden="true"><path d="M4 6l8 6 8-6M4 6h16v12H4z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></svg>
                  Enviada a andes@correo.com
                </div>
              </div>
            )}
          </div>
        </div>

        {/* Texto */}
        <div class="flex flex-col gap-2">
          <h3 class="text-[20px] leading-[1.35] tracking-[-0.02em] text-[#111]">{c.title}</h3>
          <p class="max-w-[90%] text-[16px] leading-[1.45] text-[rgba(17,17,17,0.7)]">{c.body}</p>
        </div>
      </div>
    ))}
  </div>
</section>
