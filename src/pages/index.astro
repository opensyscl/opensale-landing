---
import Base from '../layouts/Base.astro';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import Header from '../components/react/Header';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import Producto from '../components/Producto.astro';
import PorQue from '../components/PorQue.astro';
import Integraciones from '../components/Integraciones.astro';
import Pricing from '../components/Pricing.astro';
import Cierre from '../components/Cierre.astro';
import FeatureModal from '../components/FeatureModal.astro';
---

<Base>
  <AnnouncementBar />
  <Header client:load />

  <main id="inicio">
    <Hero />
    <Features />
    <Producto />
    <PorQue />
    <Integraciones />
    <Pricing />
    <Cierre />
  </main>

  <FeatureModal />
</Base>
