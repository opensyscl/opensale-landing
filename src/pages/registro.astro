---
/**
 * Alta de cuenta. Pide lo minimo —nombre del negocio y correo— y el resto se
 * completa adentro del ERP durante el onboarding. Cada campo de mas en este
 * formulario es gente que no lo termina.
 */
import Auth from '../layouts/Auth.astro';
import GoogleAuth from '../components/GoogleAuth.astro';
import { site } from '../config/site';
---

<Auth
  title="Crear cuenta"
  encabezado="Creá tu cuenta"
  bajada="Plan Starter gratis, sin tarjeta. Cargás tu primera venta hoy."
>
  <GoogleAuth etiqueta="Registrarme con Google" />

  <form action={`${site.appUrl}/register`} method="get" class="flex flex-col gap-3">
    <div>
      <label for="negocio" class="sr-only">Nombre del negocio</label>
      <input
        type="text"
        id="negocio"
        name="negocio"
        required
        autocomplete="organization"
        placeholder="Nombre de tu negocio"
        class="h-11 w-full rounded-lg border border-border bg-surface px-4 text-[13px] text-ink transition-colors duration-200 outline-none placeholder:text-muted/70 focus-visible:border-accent-deep focus-visible:ring-2 focus-visible:ring-accent/30"
      />
    </div>
    <div>
      <label for="correo" class="sr-only">Correo de trabajo</label>
      <input
        type="email"
        id="correo"
        name="email"
        required
        autocomplete="email"
        placeholder="Tu correo de trabajo"
        class="h-11 w-full rounded-lg border border-border bg-surface px-4 text-[13px] text-ink transition-colors duration-200 outline-none placeholder:text-muted/70 focus-visible:border-accent-deep focus-visible:ring-2 focus-visible:ring-accent/30"
      />
    </div>
    <button
      type="submit"
      class="boton-relieve flex h-11 w-full cursor-pointer items-center justify-center rounded-lg bg-accent-deep text-[13px] font-medium text-canvas transition-colors duration-200 hover:bg-accent-deep/90"
    >
      Crear cuenta gratis
    </button>
  </form>

  <p class="mt-6 border-t border-border pt-6 text-center text-[13px] text-muted">
    ¿Ya tenés cuenta?{' '}
    <a href="/ingresar" class="font-medium text-ink underline underline-offset-2 transition-opacity duration-200 hover:opacity-70">
      Iniciá sesión
    </a>
  </p>
</Auth>
