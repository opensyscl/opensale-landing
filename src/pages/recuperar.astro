---
/**
 * Recuperacion de clave. El ERP decide si el correo existe o no; aca solo se
 * entrega. La respuesta nunca dice si la cuenta existe: eso seria un oraculo
 * para saber que correos estan registrados.
 */
import Auth from '../layouts/Auth.astro';
import { site } from '../config/site';
---

<Auth
  title="Recuperar contraseña"
  encabezado="¿Olvidaste la clave?"
  bajada="Poné tu correo y te mandamos un enlace para crear una nueva."
  pie="ninguno"
>
  <form action={`${site.appUrl}/recuperar`} method="get" class="mt-8 flex flex-col gap-3">
    <label for="correo" class="sr-only">Correo de trabajo</label>
    <input
      type="email"
      id="correo"
      name="email"
      required
      autocomplete="email"
      placeholder="Tu correo de trabajo"
      class="h-11 w-full rounded-lg border border-border bg-surface px-4 text-[13px] text-ink transition-colors duration-200 outline-none placeholder:text-muted/70 focus-visible:border-accent-deep focus-visible:ring-2 focus-visible:ring-accent/30"
    />
    <button
      type="submit"
      class="boton-relieve flex h-11 w-full cursor-pointer items-center justify-center rounded-lg bg-accent-deep text-[13px] font-medium text-canvas transition-colors duration-200 hover:bg-accent-deep/90"
    >
      Mandame el enlace
    </button>
  </form>

  <p class="mt-6 border-t border-border pt-6 text-center text-[13px] text-muted">
    <a href="/ingresar" class="underline underline-offset-2 transition-colors duration-200 hover:text-ink">
      Volver al ingreso
    </a>
  </p>
</Auth>
