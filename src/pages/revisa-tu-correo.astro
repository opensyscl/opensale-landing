---
/**
 * Pantalla de confirmacion, comun al registro y a la recuperacion. No nombra
 * cual de las dos fue ni confirma que el correo exista.
 */
import Auth from '../layouts/Auth.astro';
import { site } from '../config/site';
---

<Auth
  title="Revisá tu correo"
  encabezado="Revisá tu correo"
  bajada="Si ese correo tiene una cuenta, le acaba de llegar un enlace. Vence en 30 minutos."
  pie="ninguno"
>
  <div class="mt-8 flex flex-col items-center gap-5">
    <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-accent/12 text-accent-deep">
      <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" aria-hidden="true">
        <path
          d="M3 7.5A2.5 2.5 0 0 1 5.5 5h13A2.5 2.5 0 0 1 21 7.5v9a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 16.5v-9Zm1 .5 8 5 8-5"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </span>

    <p class="text-center text-[13px] leading-[1.6] text-muted">
      ¿No llegó? Mirá el correo no deseado antes de volver a pedirlo.
    </p>

    <a
      href="/ingresar"
      class="flex h-11 w-full items-center justify-center rounded-lg border border-border bg-surface text-[13px] font-medium text-ink transition-colors duration-200 hover:bg-ink/[0.03]"
    >
      Volver al ingreso
    </a>
  </div>

  <p class="mt-6 border-t border-border pt-6 text-center text-[13px] text-muted">
    ¿Problemas? Escribinos a{' '}
    <a href={`mailto:${site.email}`} class="font-medium text-ink underline underline-offset-2">
      {site.email}
    </a>
  </p>
</Auth>
